<!--    </modules>-->

    <!-- Project Dependencies -->
    <dependencyManagement>

        <dependencies>
            <dependency>
                <groupId>dk.nordics</groupId>
                <artifactId>kreds-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dk.nordics</groupId>
                <artifactId>kreds-api</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>

    </dependencyManagement>

