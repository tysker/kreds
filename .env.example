# Postgres admin (superuser): only for maintenance, never used by an app
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change-me
# Monitoring role for postgres_exporter (statistics only, no access to linden/keycloak data)
MONITORING_DB_PASSWORD=change-me

# Keycloak – temporary admin for the master realm (first start only)
KEYCLOAK_ADMIN_USER=linden-admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# One login role per application (created by postgres/init on the first start)
# Generate each with: openssl rand -hex 24
LINDEN_DB_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me

# Garage – generate the secret with: openssl rand -hex 32
GARAGE_RPC_SECRET=change-me-64-hex-characters
GARAGE_ADMIN_TOKEN=change-me

# Filled in after the one-time setup (docs/local-setup.md)
GARAGE_ACCESS_KEY_ID=
GARAGE_SECRET_ACCESS_KEY=

# Garage – read-only token for Prometheus (/metrics only). Generate with: openssl rand -hex 32
GARAGE_METRICS_TOKEN=change-me

# Grafana – the only monitoring UI with a login (ADR-0003). Applied on the very first start only.
GRAFANA_ADMIN_USER=linden-admin
GRAFANA_ADMIN_PASSWORD=change-me
