# Postgres admin (superuser): only for maintenance, never used by an app
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change-me

# One login role per application (created by postgres/init on the first start)
# Generate each with: openssl rand -hex 24
KREDS_DB_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me

OPENSEARCH_VERSION=3.9.0

# Garage – generate the secret with: openssl rand -hex 32
GARAGE_RPC_SECRET=change-me-64-hex-characters
GARAGE_ADMIN_TOKEN=change-me

# Filled in after the one-time setup (docs/local-setup.md)
GARAGE_ACCESS_KEY_ID=
GARAGE_SECRET_ACCESS_KEY=